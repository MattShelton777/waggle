# Copy to .env and fill in. Never commit .env.

# Supabase (dedicated Waggle project)
WAGGLE_SUPABASE_URL=
# Credential the MCP server uses; must map to the waggle_api role (RPC only).
WAGGLE_DB_API_KEY=
# Owner/admin credential. Never deploy this to the MCP server.
WAGGLE_SUPABASE_SERVICE_ROLE_KEY=

# Public MCP endpoint, e.g. https://waggle.superproductive.co/mcp
WAGGLE_PUBLIC_URL=

# Newsletter platform (beehiiv assumed; confirm)
WAGGLE_NEWSLETTER_API_KEY=
WAGGLE_NEWSLETTER_PUBLICATION_ID=

# Transactional email for magic links and approval emails (e.g. Resend)
WAGGLE_EMAIL_API_KEY=
WAGGLE_EMAIL_FROM=

# Optional LLM screen / summaries (off by default, budget-capped)
WAGGLE_LLM_SCREEN_ENABLED=false
WAGGLE_LLM_SUMMARIES_ENABLED=false
WAGGLE_LLM_MONTHLY_BUDGET_USD=0
WAGGLE_ANTHROPIC_API_KEY=

# Give-to-get (§7.3)
WAGGLE_GIVE_TO_GET_ENABLED=true
WAGGLE_GRACE_DAYS=30
WAGGLE_WINDOW_DAYS=30
