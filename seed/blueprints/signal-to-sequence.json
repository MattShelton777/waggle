  "blueprint": {
    "blueprint_version": 1,
    "entity": "signal-to-sequence",
    "summary": "Detects a public trigger such as hiring or a launch, writes a first line that references it, and enrolls the contact in a sequence. Not yet run first-hand in Waggle: every line is from docs or inferred.",
    "use_when": [
      "You have a target account list and a trigger that signals need",
      "Mailboxes are already warmed"
    ],
    "avoid_when": [
      "Mailboxes are new",
      "The trigger is too common to mean anything"
    ],
    "inputs": [
      {
        "name": "accounts",
        "kind": "csv",
        "required": true
      },
      {
        "name": "signal",
        "kind": "text",
        "required": true,
        "note": "For example a hiring post for a given role"
      }
    ],
    "outputs": [
      {
        "name": "enrolled_contacts",
        "format": "csv",
        "fields": [
          "account",
          "signal",
          "first_line",
          "contact",
          "sequence"
        ]
      }
    ],
    "setup": [
      {
        "do": "Warm every sending mailbox before the first campaign.",
        "source": "docs"
      },
      {
        "do": "Confirm the Clay plan includes the integrations the push to the sender needs.",
        "source": "docs"
      }
    ],
    "steps": [
      {
        "n": 1,
        "do": "Search for the signal per account and keep only recent, specific matches.",
        "tool": "exa",
        "settings": {},
        "gotchas": [
          "Fetch page contents only for kept results"
        ],
        "source": "inferred"
      },
      {
        "n": 2,
        "do": "Find and verify a contact at each account with a signal, running providers only on rows that need them.",
        "tool": "clay",
        "settings": {
          "run_condition": "signal found"
        },
        "source": "inferred"
      },
      {
        "n": 3,
        "do": "Write a first line that names the signal plainly, then review a sample by hand.",
        "tool": "clay",
        "settings": {},
        "source": "inferred"
      },
      {
        "n": 4,
        "do": "Enroll contacts at a low daily volume with warmup still on.",
        "tool": "smartlead",
        "settings": {},
        "source": "docs"
      }
    ],
    "thresholds": [
      {
        "name": "Minimum mailbox warmup",
        "value": "14 days",
        "why": "Shorter warmup risks deliverability",
        "source": "docs"
      }
    ],
    "pitfalls": [
      {
        "issue": "Running enrichment on accounts with no signal",
        "fix": "Gate enrichment on a found signal",
        "source": "inferred"
      },
      {
        "issue": "Generic first lines that only restate the signal",
        "fix": "Say why the signal matters to them in one clause",
        "source": "inferred"
      }
    ],
    "quality_bar": [
      "Every enrolled contact has a dated signal",
      "A hand-reviewed sample of first lines"
    ],
